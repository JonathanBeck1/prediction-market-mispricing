# Copy to config/runtime.env for 24/7 daemon settings.
# launchd services load this file automatically via app/config.py.

# Core mode
KALSHI_MOCK=0
MAINTENANCE_ENABLED=1

# Optional transcript ingestion
# TRANSCRIPT_SOURCE=directhttp
# TRANSCRIPT_URLS=https://example.com/live-transcript

# Optional OpenClaw relay settings
# OPENCLAW_BROWSER_PROFILE=openclaw
# OPENCLAW_TIMEOUT_SEC=30

# Optional notifications
# WHATSAPP_ENABLED=1
# WHATSAPP_TARGET=+1234567890

# Optional X deterministic pipeline
# X_BEARER_TOKEN=your_token_here
# X_MONTHLY_BUDGET_USD=25
# X_DAILY_POST_RESOURCE_CAP=300

# Maintenance cadence (seconds)
# MAINTENANCE_INTERVAL_SEC=60
# EVENT_SEED_INTERVAL_SEC=300
# FETCH_MARKETS_INTERVAL_SEC=3600
# FETCH_POLY_INTERVAL_SEC=1800
# FETCH_WALLET_FLOW_INTERVAL_SEC=1800
# FETCH_NEWS_INTERVAL_SEC=1800
# FETCH_X_INTERVAL_SEC=1800
# FETCH_OUTCOMES_INTERVAL_SEC=21600
# RECORD_OUTCOMES_INTERVAL_SEC=21600

# Signal blending guardrails
# POLY_MIN_CONFIDENCE=0.35
# WALLET_FLOW_WEIGHT=0.12
# WALLET_MIN_CONFIDENCE=0.35
# ADAPTIVE_EV_SCALE=0.05
# SOURCE_AGREEMENT_WEIGHT=0.04

# Optional override for free RSS feeds (comma separated)
# NEWS_FEED_URLS=https://news.google.com/rss/search?q=Trump+OR+White+House&hl=en-US&gl=US&ceid=US:en

# Optional Kalshi event scrape fallback command (stdout must be JSON)
# Example:
# KALSHI_EVENT_SCRAPE_CMD=openclaw run your_kalshi_event_scrape_workflow --json

# Watchdog / auto-restart controls
# WATCHDOG_ENABLED=1
# WATCHDOG_INTERVAL_SEC=60
# WATCHDOG_MAX_SNAPSHOT_AGE_SEC=300
# WATCHDOG_MAX_SCORER_IDLE_SEC=300
# WATCHDOG_STARTUP_GRACE_SEC=180
# WATCHDOG_BREACH_LIMIT=3
# WATCHDOG_EXIT_ON_STALE=1
